# No private key belongs in this file or on the API server.
PAYMENTS_ENABLED=false
PAYMENTS_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
PAYMENTS_ESCROW_ADDRESS=
PAYMENTS_TREASURY_ADDRESS=

# Separate free Founding 50 contract. Do not reuse the old escrow address.
PILOT_ENABLED=false
PILOT_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
PILOT_ESCROW_ADDRESS=
PILOT_TREASURY_ADDRESS=0x6f0e740A38C80036b8B0e5C613725B047BcDa4BD

# Arbitrum One production candidate. Keep both switches false until the reviewed
# bytecode, separate Safe addresses, validator quorum and policy hashes are final.
MAINNET_ENABLED=false
MAINNET_ACCEPTING_FUNDS=false
MAINNET_DEPLOYMENT_UI=false
MAINNET_OPERATIONS_UI=false
MAINNET_DEPLOYER_ADDRESS=0x21a7b51ffF1963C3EE530097B6A71a294a09c26D
MAINNET_RPC_URL=
MAINNET_ESCROW_ADDRESS=
MAINNET_TREASURY_SAFE=
MAINNET_OPERATIONS_SAFE=
MAINNET_AUTOMATIC_POLICY_HASH=0xfc80263827b1f14bff464b89bebc2c5d237a1b355706054f47de87fd1e5bc556
MAINNET_REVIEW_POLICY_HASH=0x3f9234a62a913d1efc1882bc7c2b2bd289cbcb28c8dcf62f5f949c49c99b3014

# Pre-funding buyer/seller discussion. Use a persistent Render disk path in production.
NEGOTIATION_ENABLED=false
NEGOTIATION_DB_PATH=/var/data/agentnotary/negotiations.db

# Read-only twice-daily operational report. Keep credentials in Render secrets.
REPORTING_ENABLED=false
MAINNET_DEPLOYMENT_BLOCK=
REPORT_TIMEZONE=Europe/Istanbul
REPORT_RECIPIENT=
REPORT_TRIGGER_TOKEN=
REPORT_DASHBOARD_PASSWORD=
REPORT_SESSION_SECRET=
# USDC sent from Treasury Safe to this wallet is shown as "Owner withdrawals".
REPORT_OWNER_PAYOUT_ADDRESS=
REPORT_SMTP_HOST=smtp.gmail.com
REPORT_SMTP_PORT=465
REPORT_SMTP_USER=
REPORT_SMTP_APP_PASSWORD=

# Three-provider AI dispute triage. The app stores no wallet/signing key. Each
# provider uses an independent OpenAI-compatible HTTPS endpoint and account.
AI_REVIEW_ENABLED=false
AI_REVIEW_DB_PATH=/var/data/agentnotary/ai-review.db
AI_REVIEW_TRIGGER_TOKEN=
AI_REVIEW_MIN_CONFIDENCE_BPS=8500
AI_REVIEW_AUTOMATIC_CAP_UNITS=250000000
AI_REVIEW_MAX_EVIDENCE_BYTES=1000000
# Comma-separated hostnames only. Private/reserved IP addresses and redirects are rejected.
AI_REVIEW_ALLOWED_EVIDENCE_HOSTS=
AI_REVIEW_IPFS_GATEWAY=
AI_REVIEW_ARWEAVE_GATEWAY=
AI_REVIEW_PROVIDER_A_URL=
AI_REVIEW_PROVIDER_A_MODEL=
AI_REVIEW_PROVIDER_A_API_KEY=
AI_REVIEW_PROVIDER_B_URL=
AI_REVIEW_PROVIDER_B_MODEL=
AI_REVIEW_PROVIDER_B_API_KEY=
AI_REVIEW_PROVIDER_C_URL=
AI_REVIEW_PROVIDER_C_MODEL=
AI_REVIEW_PROVIDER_C_API_KEY=
AI_REVIEW_SIGNER_A_URL=
AI_REVIEW_SIGNER_A_TOKEN=
AI_REVIEW_SIGNER_B_URL=
AI_REVIEW_SIGNER_B_TOKEN=
AI_REVIEW_SIGNER_C_URL=
AI_REVIEW_SIGNER_C_TOKEN=
# The relayer must deduplicate idempotency_key. No wallet key is stored here.
AI_REVIEW_RELAYER_URL=
AI_REVIEW_RELAYER_TOKEN=
AI_REVIEW_RELAYER_ADDRESS=
